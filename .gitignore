# OS
.DS_Store

# Local environment config (API key paths differ per machine)
local/azure.json
local/azure_*.txt

# MDocAgent per-model Hydra overrides (regenerated per run, hash keyed by model name)
src/baseline/mdocagent/config_overrides/model/
