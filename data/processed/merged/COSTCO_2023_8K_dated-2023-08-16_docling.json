      ],
      "orig": "COSTCO WHOLESALE CORPORATION ANNOUNCES NEW BOARD MEMBER",
      "text": "COSTCO WHOLESALE CORPORATION ANNOUNCES NEW BOARD MEMBER",
      "level": 1
    },
    {
      "self_ref": "#/texts/49",
      "parent": {
        "$ref": "#/body"
      },
      "children": [],
