{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json, re, statistics\nfrom pathlib import Path\ntry:\n    import tiktoken\n    enc=tiktoken.get_encoding('cl100k_base')\n    count=lambda s: len(enc.encode(s))\nexcept Exception:\n    count=lambda s: int(len(s.split())*1.3)\n\nQ='What is the reporting period covered by this document (e.g. fiscal year ended, quarter ended, or event date)?'\nDOCS=['BOEING_2019_10K','ADOBE_2020_10K','ACTIVISIONBLIZZARD_2020_10K','COSTCO_2018_10K','AMCOR_2019_10K','AMAZON_2020_10K','AMAZON_2019_10K','ADOBE_2021_10K','EBAY_2022_10K','ADOBE_2019_10K','AMCOR_2023Q2_10Q','ADOBE_2022Q2_10Q','ACTIVSIONBLIZZARD_2023Q2_10Q','3M_2023Q2_10Q','AMCOR_2022_8K_2022-07-01','COSTCO_2023_8K_dated-2023-08-09','COSTCO_2023_8K_dated-2023-08-16','FOOTLOCKER_2022_8K_dated-2022-05-20']\nlabels=json.load(open('/mnt/data/LSF/data/financebench/sample/multi_cluster/random/sample_doc_labels.json'))\n\n\ndef apply_rules(doc):\n    texts=doc['texts']\n    out=[]\n    seen=set()\n    def add(i,s):\n        if i not in seen:\n            seen.add(i); out.append(s)\n    for i,s in enumerate(texts):\n        t=s.get('text','')\n        tl=t.lower()\n        path=((s.get('structure') or {}).get('path_text') or '').lower()\n        label=s.get('label')\n        page=s.get('page_no') or 0\n        if page<=2 and label in {'text','section_header','checkbox_selected'} and re.search(r'\\\\bfor the fiscal year ended\\\\b|\\\\bfor the year ended\\\\b|\\\\bfiscal year ended\\\\b', tl):\n            add(i,s)\n        if page<=2 and label in {'text','section_header','checkbox_selected'} and re.search(r'\\\\bfor the quarterly period ended\\\\b|\\\\bfor the quarter ended\\\\b|\\\\bquarterly period ended\\\\b|\\\\bquarter ended\\\\b', tl):\n            add(i,s)\n        if page<=2 and label in {'text','section_header'} and ('date of report' in tl and 'earliest event reported' in tl):\n            add(i,s)\n        if page<=3 and label in {'text','section_header','checkbox_selected'} and re.search(r'\\\\bfor the fiscal year ended\\\\b|\\\\bfor the year ended\\\\b|\\\\bfor the quarterly period ended\\\\b|\\\\bfor the quarter ended\\\\b', tl) and (s.get('bold')==1 or 'form 10-' in path or 'current report' in path):\n            add(i,s)\n        if page<=2 and 'form 10-' in path and re.search(r'\\\\bended\\\\b|date of report', tl) and label in {'text','section_header','checkbox_selected'}:\n            add(i,s)\n    return out\n\nhits=[]\ncosts=[]\nmiss=[]\nfor d in DOCS:\n    p=Path('/mnt/data/LSF/data/financebench/processing')/f'{d}_reconstructed.json'\n    doc=json.load(open(p))\n    gt=labels[d+'.pdf'][Q]\n    spans=apply_rules(doc)\n    txt='\\\\n'.join(s.get('text','') for s in spans)\n    hit=gt.lower() in txt.lower()\n    full='\\\\n'.join(s.get('text','') for s in doc['texts'])\n    cost=count(txt)/max(count(full),1)\n    hits.append(hit); costs.append(cost)\n    if not hit:\n        miss.append((d,gt,txt[:500]))\n    print(d, 'spans', len(spans), 'hit', hit, 'cost', round(cost,5))\nprint('hit_rate', sum(hits)/len(hits), 'avg_cost', sum(costs)/len(costs))\nprint('misses', miss)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
