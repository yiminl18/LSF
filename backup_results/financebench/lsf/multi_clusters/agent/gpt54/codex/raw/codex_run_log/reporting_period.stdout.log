{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json, re\nfrom pathlib import Path\ntry:\n    import tiktoken\n    enc=tiktoken.get_encoding('cl100k_base')\n    count=lambda s: len(enc.encode(s))\nexcept Exception:\n    count=lambda s: int(len(s.split())*1.3)\nQ='What is the reporting period covered by this document (e.g. fiscal year ended, quarter ended, or event date)?'\nDOCS=['BOEING_2019_10K','ADOBE_2020_10K','ACTIVISIONBLIZZARD_2020_10K','COSTCO_2018_10K','AMCOR_2019_10K','AMAZON_2020_10K','AMAZON_2019_10K','ADOBE_2021_10K','EBAY_2022_10K','ADOBE_2019_10K','AMCOR_2023Q2_10Q','ADOBE_2022Q2_10Q','ACTIVSIONBLIZZARD_2023Q2_10Q','3M_2023Q2_10Q','AMCOR_2022_8K_2022-07-01','COSTCO_2023_8K_dated-2023-08-09','COSTCO_2023_8K_dated-2023-08-16','FOOTLOCKER_2022_8K_dated-2022-05-20']\nlabels=json.load(open('/mnt/data/LSF/data/financebench/sample/multi_cluster/random/sample_doc_labels.json'))\n\ndef r1(s):\n    tl=s.get('text','').lower(); page=s.get('page_no') or 0; label=s.get('label')\n    return page<=2 and label in {'text','section_header','checkbox_selected'} and re.search(r'\\\\bfor the fiscal year ended\\\\b|\\\\bfor the year ended\\\\b|\\\\bfiscal year ended\\\\b', tl)\n\ndef r2(s):\n    tl=s.get('text','').lower(); page=s.get('page_no') or 0; label=s.get('label')\n    return page<=2 and label in {'text','section_header','checkbox_selected'} and re.search(r'\\\\bfor the quarterly period ended\\\\b|\\\\bfor the quarter ended\\\\b|\\\\bquarterly period ended\\\\b|\\\\bquarter ended\\\\b', tl)\n\ndef r3(s):\n    tl=s.get('text','').lower(); page=s.get('page_no') or 0; label=s.get('label')\n    return page<=2 and label in {'text','section_header'} and ('date of report' in tl and 'earliest event reported' in tl)\n\ndef r4(s):\n    tl=s.get('text','').lower(); page=s.get('page_no') or 0; label=s.get('label'); path=((s.get('structure') or {}).get('path_text') or '').lower()\n    return page<=3 and label in {'text','section_header','checkbox_selected'} and re.search(r'\\\\bfor the fiscal year ended\\\\b|\\\\bfor the year ended\\\\b|\\\\bfor the quarterly period ended\\\\b|\\\\bfor the quarter ended\\\\b', tl) and (s.get('bold')==1 or 'form 10-' in path or 'current report' in path)\n\ndef r5(s):\n    tl=s.get('text','').lower(); page=s.get('page_no') or 0; label=s.get('label'); path=((s.get('structure') or {}).get('path_text') or '').lower()\n    return page<=2 and 'form 10-' in path and label in {'text','section_header','checkbox_selected'} and re.search(r'\\\\bended\\\\b|date of report', tl)\nrules=[('rule_page12_fiscal_year_period',r1),('rule_page12_quarterly_period',r2),('rule_page12_8k_event_line',r3),('rule_page13_bold_period_heading',r4),('rule_page12_form_path_period',r5)]\nfor name,fn in rules:\n    cov=0; costs=[]\n    for d in DOCS:\n        doc=json.load(open(Path('/mnt/data/LSF/data/financebench/processing')/f'{d}_reconstructed.json'))\n        gt=labels[d+'.pdf'][Q].lower()\n        spans=[s for s in doc['texts'] if fn(s)]\n        txt='\\\\n'.join(s.get('text','') for s in spans)\n        if gt in txt.lower(): cov+=1\n        full='\\\\n'.join(s.get('text','') for s in doc['texts'])\n        costs.append(count(txt)/max(count(full),1))\n    print(name, 'coverage', cov, 'avg_cost', round(sum(costs)/len(costs),6))\n# union\nfor d in DOCS:\n    doc=json.load(open(Path('/mnt/data/LSF/data/financebench/processing')/f'{d}_reconstructed.json'))\n    texts=doc['texts']; idx={id(s):i for i,s in enumerate(texts)}; seen=set(); out=[]\n    for _,fn in rules:\n        for s in texts:\n            if fn(s):\n                i=idx[id(s)]\n                if i not in seen:\n                    seen.add(i); out.append(s)\n    txt='\\\\n'.join(s.get('text','') for s in out)\n    gt=labels[d+'.pdf'][Q].lower()\n    print('UNION',d,len(out),gt in txt.lower())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
