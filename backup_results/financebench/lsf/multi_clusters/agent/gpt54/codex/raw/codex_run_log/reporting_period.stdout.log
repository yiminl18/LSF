{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json, re, os\nq='What is the reporting period covered by this document (e.g. fiscal year ended, quarter ended, or event date)?'\nlabels=json.load(open('/mnt/data/LSF/data/financebench/sample/multi_cluster/random/sample_doc_labels.json'))\ndocs=['BOEING_2019_10K','ADOBE_2020_10K','ACTIVISIONBLIZZARD_2020_10K','COSTCO_2018_10K','AMCOR_2019_10K','AMAZON_2020_10K','AMAZON_2019_10K','ADOBE_2021_10K','EBAY_2022_10K','ADOBE_2019_10K','AMCOR_2023Q2_10Q','ADOBE_2022Q2_10Q','Pfizer_2023Q2_10Q','ACTIVSIONBLIZZARD_2023Q2_10Q','3M_2023Q2_10Q','AMCOR_2022_8K_2022-07-01','COSTCO_2023_8K_dated-2023-08-09','COSTCO_2023_8K_dated-2023-08-16','MGMRESORTS_2023_8K_dated-2023-03-01','FOOTLOCKER_2022_8K_dated-2022-05-20']\nfor d in docs:\n    gt=(labels.get(d+'.pdf',{}) or {}).get(q)\n    p=f'/mnt/data/LSF/data/financebench/processing/{d}_reconstructed.json'\n    doc=json.load(open(p))\n    texts=doc.get('texts',[])\n    hit=[]\n    if isinstance(gt,str):\n        gt_l=gt.lower()\n        for i,s in enumerate(texts):\n            if gt_l in (s.get('text','').lower()):\n                hit.append((i,s))\n    print('\\\\nDOC',d,'GT',gt,'MATCHES',len(hit))\n    for i,s in hit[:5]:\n        st=s.get('structure') or {}\n        print({'i':i,'page':s.get('page_no'),'label':s.get('label'),'bold':s.get('bold'),'size':s.get('size'),'level':st.get('level'),'path':st.get('path_text'),'text':s.get('text')[:220]})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
