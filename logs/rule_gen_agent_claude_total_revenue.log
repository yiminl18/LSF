f income and other information\' in full:\n                sc += 7\n            if \'item 16\' in full:\n                sc -= 1\n            if \'item 7\' in full or \'management\' in full:\n                sc -= 2\n            if \'note \' in full or \'segment\' in full or \'geography\' in full or \'type\' in full or \'seasonality\' in full:\n                sc -= 4\n            if \'revenue\' in text.lower() or \'net sales\' in text.lower() or \'net revenues\' in text.lower() or \'sales |\' in text.lower() or \'total net revenue\' in text.lower():\n                sc += 2\n            return sc\n\n        candidates = []\n        for s in texts:\n            if s.get(\'label\') != \'table\':\n                continue\n            text = (s.get(\'text\', \'\') or \'\')\n            pt = ((s.get(\'structure\', {}) or {}).get(\'path_text\', \'\') or \'\')\n            full = (pt + \' \' + text).lower()\n            if not any(k in full for k in [\n                \'revenue\', \'revenues\', \'net sales\', \'net revenues\', \'sales of products\', \'sales |\', \'total net revenue\'\n            ]):\n                continue\n            if any(bad in full for bad in [\'cash flows\', \'balance sheets\', \'comprehensive income\', \'other comprehensive\']):\n                continue\n            candidates.append((score(s), s))\n\n        candidates.sort(key=lambda x: x[0], reverse=True)\n        return [s for _, s in candidates[:3]]\n    except Exception:\n        return []\n\n\ndef rule_selected_financial_data_fallback(doc: dict) -> list[dict]:\n    """Fallback to selected financial data / results tables with net sales or total revenue for latest year."""\n    try:\n        texts = doc.get(\'texts\', [])\n        out = []\n        for s in texts:\n            if s.get(\'label\') != \'table\':\n                continue\n            text = (s.get(\'text\', \'\') or \'\')\n            pt = ((s.get(\'structure\', {}) or {}).get(\'path_text\', \'\') or \'\')\n            full = (pt + \' \' + text).lower()\n            if any(x in full for x in [\'selected financial data\', \'item 6\', \'results of operations\', \'three year review of results\']):\n                if any(k in text.lower() for k in [\'net sales\', \'net revenues\', \'total revenue\', \'consolidated |\', \'sales |\']):\n                    if not any(bad in full for bad in [\'segment\', \'geography\', \'type\', \'seasonality\', \'cost of net revenues\', \'sales and marketing\']):\n                        out.append(s)\n        return out[:3]\n    except Exception:\n        return []\n'}`


