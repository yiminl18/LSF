def _safe_text(span):
    try:
        return (span.get("text") or "")
    except Exception:
        return ""


def _safe_path(span):
    try:
        return ((span.get("structure") or {}).get("path_text") or "")
    except Exception:
        return ""


def _cells_text(span):
    try:
        if span.get("label") != "table":
            return ""
        cells = ((span.get("table_data") or {}).get("cells") or [])
        return " | ".join((c.get("text") or "") for c in cells)
    except Exception:
        return ""


def _table_has_row_label(span, labels):
    try:
        if span.get("label") != "table":
            return False
        cells = ((span.get("table_data") or {}).get("cells") or [])
        labels_l = [x.lower() for x in labels]
        for c in cells:
            txt = (c.get("text") or "").strip().lower()
            if txt in labels_l:
                return True
        return False
    except Exception:
        return False


def rule_long_term_debt_balance_sheet(doc: dict) -> list[dict]:
    """Balance sheet tables/spans containing long-term debt or debt under long-term liabilities."""
    try:
        out = []
        for span in doc.get("texts", []):
            txt = _safe_text(span)
            low = txt.lower()
            path = _safe_path(span).lower()
            cells = _cells_text(span).lower()

            is_balance = (
                "balance sheet" in low
                or "balance sheets" in low
                or "balance sheet" in path
                or "balance sheets" in path
                or "condensed consolidated balance sheets" in low
                or "consolidated balance sheets" in low
            )
            if not is_balance:
                continue

            if span.get("label") == "table":
                if (
                    "long-term debt" in cells
                    or "long term debt" in cells
                    or ("long-term liabilities" in cells and _table_has_row_label(span, ["Debt", "Long-term debt"]))
                    or ("long term liabilities" in cells and _table_has_row_label(span, ["Debt", "Long-term debt"]))
                    or _table_has_row_label(span, ["Long-term debt"])
                ):
                    out.append(span)
            else:
                if "long-term debt" in low or "long term debt" in low:
                    out.append(span)
        return out
    except Exception:
        return []


def rule_total_debt_balance_sheet(doc: dict) -> list[dict]:
    """Balance sheet tables where the answer is simply the long-term/noncurrent 'Debt' row."""
    try:
        out = []
        for span in doc.get("texts", []):
            if span.get("label") != "table":
                continue
            low = _safe_text(span).lower()
            path = _safe_path(span).lower()
            cells = _cells_text(span).lower()

            is_balance = (
                "balance sheet" in low
                or "balance sheets" in low
                or "balance sheet" in path
                or "balance sheets" in path
            )
            if not is_balance:
                continue

            if (
                _table_has_row_label(span, ["Debt"])
                and (
                    "long-term liabilities" in cells
                    or "long term liabilities" in cells
                    or "non-current liabilities" in cells
                    or "liabilities and stockholders' equity" in cells
                )
            ):
                out.append(span)
        return out
    except Exception:
        return []


def rule_debt_note_or_text_disclosure(doc: dict) -> list[dict]:
    """Debt note / MD&A text explicitly stating long-term debt or debt balances as of year-end."""
    try:
        out = []
        for span in doc.get("texts", []):
            txt = _safe_text(span)
            low = txt.lower()
            path = _safe_path(span).lower()

            if "long-term debt" in low or "long term debt" in low:
                out.append(span)
                continue

            if (
                ("debt" in low or "borrowings" in low)
                and (
                    "as of december" in low
                    or "as of june" in low
                    or "as of october" in low
                    or "as of september" in low
                    or "year-end" in low
                    or "year end" in low
                )
            ):
                out.append(span)
                continue

            if (
                ("debt" in path or "borrowings" in path)
                and ("as of" in low or "year-end" in low or "year end" in low)
            ):
                out.append(span)
        return out
    except Exception:
        return []


def rule_no_long_term_debt_8k(doc: dict) -> list[dict]:
    """8-K current reports with no balance sheet / financial statements; answer should be 0."""
    try:
        texts = doc.get("texts", [])
        has_8k = any("form 8-k" in _safe_text(s).lower() for s in texts)
        has_balance = any(
            "balance sheet" in _safe_text(s).lower() or "balance sheet" in _safe_path(s).lower()
            for s in texts
        )
        if has_8k and not has_balance:
            return [
                s for s in texts
                if "form 8-k" in _safe_text(s).lower()
                or "current report" in _safe_text(s).lower()
            ][:5]
        return []
    except Exception:
        return []
