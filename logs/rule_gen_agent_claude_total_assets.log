score -= 5\n            # prefer tables that start with assets section\n            if re.search(r\'\\n\\|\\s*assets\\s*\\|\', low):\n                score += 2\n            candidates.append((score, sp))\n\n        if not candidates:\n            return []\n        candidates.sort(key=lambda x: x[0], reverse=True)\n        return [candidates[0][1]]\n    except Exception:\n        return []\n\n\ndef rule_total_assets_fallback_any_balance_table(doc: dict) -> list[dict]:\n    """Fallback: any table under balance sheet path mentioning assets, else 0 for 8-K."""\n    try:\n        texts = doc.get(\'texts\', []) or []\n        name = (doc.get(\'doc_name\') or doc.get(\'name\') or \'\').lower()\n        if \'8-k\' in name or \'8k\' in name:\n            return [{\'text\': \'0\', \'label\': \'synthetic\', \'page_no\': 0, \'path_text\': \'synthetic no audited balance sheet in 8-K\'}]\n        out = []\n        for sp in texts:\n            if sp.get(\'label\') != \'table\':\n                continue\n            txt = (sp.get(\'text\', \'\') or \'\').lower()\n            path = ((sp.get(\'structure\', {}) or {}).get(\'path_text\', \'\') or sp.get(\'path_text\', \'\') or \'\').lower()\n            if \'total assets\' in txt and (\'balance sheet\' in path or \'financial position\' in path or \'financial statements\' in path):\n                out.append(sp)\n        return out[:2]\n    except Exception:\n        return []\n'}`


