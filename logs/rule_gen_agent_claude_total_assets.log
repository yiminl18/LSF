ow or \'condensed consolidated balance\' in plow:\n                score += 8\n            if \'selected financial data\' in plow or \'item 6\' in plow:\n                score -= 15\n            if \'management\' in plow or \'financial position\' in plow:\n                score -= 10\n            if \'item 16\' in plow or \'form 10-k summary\' in plow:\n                score -= 8\n            if \'fair value\' in plow or \'note \' in plow or \'discontinued operations\' in plow:\n                score -= 20\n            if \'total assets\' in low:\n                score += 10\n            if re.search(r\'\\n\\|\\s*assets\\s*\\|\', low):\n                score += 4\n            if re.search(r\'\\n\\|\\s*total assets\\s*\\|\', low):\n                score += 12\n            if score > best_score:\n                best_score = score\n                best = sp\n\n        if not best or best_score < 5:\n            return []\n\n        txt = best.get(\'text\', \'\') or \'\'\n        lines = txt.splitlines()\n        target_idx = None\n        for i, line in enumerate(lines):\n            if \'total assets\' in line.lower():\n                target_idx = i\n                break\n        if target_idx is None:\n            return [best]\n\n        start = max(0, target_idx - 2)\n        end = min(len(lines), target_idx + 1)\n        snippet = \'\\n\'.join(lines[start:end])\n        syn = dict(best)\n        syn[\'text\'] = snippet\n        syn[\'label\'] = \'synthetic\'\n        return [syn]\n    except Exception:\n        return []\n\n\ndef rule_total_assets_last_line_balance_sheet(doc: dict) -> list[dict]:\n    """Fallback focused snippet from balance sheet table ending at Total assets row."""\n    try:\n        import re\n        texts = doc.get(\'texts\', []) or []\n        out = []\n        for sp in texts:\n            if sp.get(\'label\') != \'table\':\n                continue\n            path = ((sp.get(\'structure\', {}) or {}).get(\'path_text\', \'\') or sp.get(\'path_text\', \'\') or \'\').lower()\n            txt = sp.get(\'text\', \'\') or \'\'\n            low = txt.lower()\n            if (\'balance sheet\' not in path and \'financial position\' not in path) or \'total assets\' not in low:\n                continue\n            if \'fair value\' in path or \'management\' in path or \'selected financial data\' in path:\n                continue\n            lines = txt.splitlines()\n            for i, line in enumerate(lines):\n                if \'total assets\' in line.lower():\n                    start = max(0, i-1)\n                    syn = dict(sp)\n                    syn[\'text\'] = \'\\n\'.join(lines[start:i+1])\n                    syn[\'label\'] = \'synthetic\'\n                    out.append(syn)\n                    break\n        return out[:2]\n    except Exception:\n        return []\n'}`


