```python
def rule_long_term_debt_balance_or_debt_tables(doc: dict) -> list[dict]:
    """Find long-term debt in balance sheet / debt tables, else return 0 for 8-K without financials."""
    try:
        import re
        texts = doc.get('texts', []) or []
        out = []

        def norm(s):
            return re.sub(r'\s+', ' ', (s or '').lower())

        def is_8k_no_financials():
            joined = ' '.join(norm(t.get('text','')) + ' ' + norm(t.get('structure',{}).get('path_text','')) for t in texts[:200])
            has_fin = any(('balance sheet' in norm(t.get('text','')) or 'financial statements' in norm(t.get('structure',{}).get('path_text',''))) for t in texts)
            return ('8-k' in joined or 'current report' in joined) and not has_fin

        if is_8k_no_financials():
            return [{'text': '0', 'label': 'synthetic', 'page_no': 1, 'bold': 0, 'size': 0, 'structure': {'level': 'Body', 'path_text': 'synthetic'}}]

        for span in texts:
            txt = span.get('text', '') or ''
            low = norm(txt)
            path = norm(span.get('structure', {}).get('path_text', ''))
            label = span.get('label', '')
            if label != 'table':
                continue

            good_path = any(k in path for k in [
                'balance sheet', 'statements of financial position', 'financial position',
                'debt', 'notes to consolidated financial statements | note 10 â€” debt',
                'note 4â€”debt', 'note 14. debt'
            ])
            bad_path = any(k in path for k in ['item 7a', 'market risk', 'cash flows', 'contractual obligations', 'selected financial data'])
            if not good_path or bad_path:
                continue

            if ('long-term debt' in low or 'long term debt' in low or re.search(r'\|\s*debt\s*\|', low)):
                out.append(span)
                continue
            if 'long-term debt, less current portion' in low or 'long-term debt less current portion' in low:
                out.append(span)
                continue
            if 'long-term borrowings' in low:
                out.append(span)
                continue
        return out
    except Exception:
        return []


def rule_precise_long_term_debt(doc: dict) -> list[dict]:
    """Locate long-term debt in debt note or balance sheet tables, with 8-K fallback to 0."""
    try:
        import re
        texts = doc.get('texts', []) or []
        out = []

        def n(s):
            return re.sub(r'\s+', ' ', (s or '').lower())

        joined = ' '.join(n(t.get('text','')) + ' ' + n(t.get('structure',{}).get('path_text','')) for t in texts[:80])
        if ('form 8-k' in joined or 'current report' in joined) and not any('balance sheet' in n(t.get('text','') + ' ' + t.get('structure',{}).get('path_text','')) for t in texts):
            return [{'text': '0', 'label': 'synthetic', 'page_no': 1, 'bold': 0, 'size': 0, 'structure': {'level': 'Body', 'path_text': 'synthetic 8-k no financials'}}]

        for span in texts:
            if span.get('label') != 'table':
                continue
            txt = span.get('text', '') or ''
            low = n(txt)
            path = n(span.get('structure', {}).get('path_text', ''))

            in_balance = any(k in path for k in [
                'consolidated balance sheet', 'consolidated balance sheets',
                'condensed consolidated balance sheets',
                'consolidated statement of financial position',
                'consolidated statements of financial position',
                'intel corporation consolidated balance sheets'
            ])
            in_debt_note = 'note' in path and 'debt' in path
            in_debt_section = path.endswith('| long-term debt') or '| long-term debt' in path
            in_selected = 'selected financial data' in path
            in_market_risk = 'item 7a' in path or 'market risk' in path
            in_cashflows = 'cash flows' in path
            in_contractual = 'contractual obligations' in path

            if in_cashflows or in_contractual or in_selected:
                continue
            if in_market_risk and not in_debt_section:
                continue

            if 'long-term debt' in low or 'long term debt' in low or 'long-term borrowings' in low:
                if in_balance or in_debt_note or in_debt_section:
                    out.append(span)
                    continue
            if in_balance and re.search(r'\|\s*debt\s*\|', low):
                out.append(span)
                continue
        return out
    except Exception:
        return []


def rule_amazon_debt_note(doc: dict) -> list[dict]:
    """Capture Amazon debt note table with note-level debt balances."""
    try:
        out = []
        for span in doc.get('texts', []) or []:
            if span.get('label') != 'table':
                continue
            path = (span.get('structure', {}).get('path_text', '') or '').lower()
            txt = (span.get('text', '') or '').lower()
            if 'note 5' in path and 'debt' in path and 'notes due' in txt:
                out.append(span)
        return out
    except Exception:
        return []
