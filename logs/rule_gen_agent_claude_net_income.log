Invoking: `test_rules` with `{'code': 'def rule_primary_income_tables(doc: dict) -> list[dict]:\n    """Prefer primary statements of operations/income/comprehensive income and avoid MD&A, Item 16, and cash flow tables."""\n    try:\n        import re\n        out = []\n        for span in doc.get(\'texts\', []):\n            if span.get(\'label\') != \'table\':\n                continue\n            text = (span.get(\'text\', \'\') or \'\')\n            low = text.lower()\n            path = (span.get(\'structure\', {}).get(\'path_text\', \'\') or \'\').lower()\n            if not any(k in low for k in [\'net income\', \'net earnings\', \'net income attributable\']):\n                continue\n            if any(k in path for k in [\n                \'managementâ€™s discussion\', "management\'s discussion", \'item 7.\', \'item 7a\',\n                \'selected financial data\', \'item 6\', \'item 16\', \'cash flows\', \'equity\',\n                \'earnings per share\', \'note 9\', \'quarterly financial data\'\n            ]):\n                continue\n            if any(k in path for k in [\n                \'statements of operations\', \'statements of income\', \'statement of income\',\n                \'statements of comprehensive income\', \'statement of comprehensive income\',\n                \'income and other information\'\n            ]):\n                out.append(span)\n        return out\n    except Exception:\n        return []\n\n\ndef rule_selected_or_summary_income_tables(doc: dict) -> list[dict]:\n    """Fallback to selected financial data, Item 16 summary income tables, or cash flow tables when they contain the latest net income row."""\n    try:\n        out = []\n        for span in doc.get(\'texts\', []):\n            if span.get(\'label\') != \'table\':\n                continue\n            text = (span.get(\'text\', \'\') or \'\')\n            low = text.lower()\n            path = (span.get(\'structure\', {}).get(\'path_text\', \'\') or \'\').lower()\n            if not any(k in low for k in [\'net income\', \'net earnings\', \'net income (loss)\', \'net income available\']):\n                continue\n            if any(k in path for k in [\'managementâ€™s discussion\', "management\'s discussion", \'item 7.\', \'item 7a\']):\n                continue\n            if any(k in path for k in [\n                \'selected financial data\', \'item 6\',\n                \'consolidated statements of income\', \'consolidated statement of income\',\n                \'cash flows\', \'consolidated statements of comprehensive income\'\n            ]):\n                out.append(span)\n        return out\n    except Exception:\n        return []\n\n\ndef rule_8k_none(doc: dict) -> list[dict]:\n    """Return synthetic none/0 for 8-Ks that do not contain operating results financial statements."""\n    try:\n        texts = doc.get(\'texts\', [])\n        joined = \' \'.join((t.get(\'text\', \'\') or \'\') for t in texts[:80]).lower()\n        paths = \' \'.join((t.get(\'structure\', {}).get(\'path_text\', \'\') or \'\') for t in texts[:80]).lower()\n        if \'form 8-k\' in joined and \'item 9.01. financial statements and exhibits\' in paths:\n            if not any(k in joined for k in [\'net income\', \'net earnings\', \'statements of operations\', \'statements of income\']):\n                return [{\'text\': \'None\', \'label\': \'synthetic\', \'page_no\': 1, \'bold\': 0, \'size\': 0, \'structure\': {\'level\': \'Body\', \'path_text\': \'synthetic\'}}]\n        return []\n    except Exception:\n        return []\n'}`


