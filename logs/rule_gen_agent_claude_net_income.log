```python
def rule_net_income_primary(doc: dict) -> list[dict]:
    """Locate net income/loss for the most recent fiscal year from primary income/comprehensive income tables."""
    try:
        import re
        out = []
        for span in doc.get("texts", []):
            if span.get("label") != "table":
                continue
            text = (span.get("text") or "")
            path = (span.get("structure", {}).get("path_text") or "")
            low = text.lower()
            p = path.lower()

            if not any(k in low for k in [
                "net income", "net earnings", "net income attributable", "net income (loss)"
            ]):
                continue

            # Prefer core financial statement sections
            if not any(k in p for k in [
                "statements of operations",
                "statements of income",
                "statement of income",
                "statements of comprehensive income",
                "statement of comprehensive income",
                "income and other information",
                "financial statements"
            ]):
                continue

            # Exclude noisy sections
            if any(k in p for k in [
                "management's discussion", "managementâ€™s discussion",
                "item 7.", "item 7a",
                "cash flows", "equity",
                "earnings per share", "quarterly financial data"
            ]):
                continue

            out.append(span)
        return out
    except Exception:
        return []


def rule_net_income_fallback(doc: dict) -> list[dict]:
    """Fallback to selected financial data, summary income tables, or cash flow tables when they clearly contain the latest net income row."""
    try:
        out = []
        for span in doc.get("texts", []):
            if span.get("label") != "table":
                continue
            text = (span.get("text") or "")
            path = (span.get("structure", {}).get("path_text") or "")
            low = text.lower()
            p = path.lower()

            if not any(k in low for k in [
                "net income", "net earnings", "net income (loss)",
                "net income available", "net income attributable"
            ]):
                continue

            if any(k in p for k in [
                "management's discussion", "managementâ€™s discussion",
                "item 7.", "item 7a"
            ]):
                continue

            if any(k in p for k in [
                "selected financial data",
                "item 6",
                "consolidated statements of income",
                "consolidated statement of income",
                "consolidated statements of comprehensive income",
                "cash flows"
            ]):
                out.append(span)
        return out
    except Exception:
        return []


def rule_no_financials_8k(doc: dict) -> list[dict]:
    """Return synthetic None for 8-Ks that do not contain actual operating-results financial statements."""
    try:
        texts = doc.get("texts", [])
        joined = " ".join((t.get("text") or "") for t in texts[:80]).lower()
        paths = " ".join((t.get("structure", {}).get("path_text") or "") for t in texts[:80]).lower()

        if "form 8-k" in joined and "item 9.01. financial statements and exhibits" in paths:
            if not any(k in joined for k in [
                "net income", "net earnings",
                "statements of operations", "statements of income"
            ]):
                return [{
                    "text": "None",
                    "label": "synthetic",
                    "page_no": 1,
                    "bold": 0,
                    "size": 0,
                    "structure": {"level": "Body", "path_text": "synthetic"}
                }]
        return []
    except Exception:
        return []
